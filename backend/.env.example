# ─────────────────────────────────────────────────────────────────────────────
# Bhoomi Backend — Environment Variables (.env)
# ─────────────────────────────────────────────────────────────────────────────

# Application environment: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi.py
FLASK_DEBUG=1

# Application Security Keys (Use 32+ character random strings in production)
SECRET_KEY=bhoomi-dev-secret-key-32-bytes-long-min!!
JWT_SECRET_KEY=bhoomi-jwt-dev-secret-key-32-bytes-min!!

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://bhoomi:bhoomi@localhost:5432/bhoomi_db

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS S3 Storage (Optional for local dev - mock storage used if not set)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=bhoomi-public-media
S3_BUCKET_PRIVATE=bhoomi-verification-private

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Observability (Optional)
SENTRY_DSN=
